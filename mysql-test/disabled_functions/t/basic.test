--echo # The plugin is loaded at startup by suite.opt.
SELECT PLUGIN_STATUS FROM INFORMATION_SCHEMA.PLUGINS
  WHERE PLUGIN_NAME='disabled_functions';

SELECT @@disabled_functions_list;

--echo # Functions named in disabled_functions_list are unavailable.
--disable_query_log
--disable_result_log
--error ER_SP_DOES_NOT_EXIST
SELECT SLEEP(0);
--error ER_SP_DOES_NOT_EXIST
SELECT COLUMN_LIST(COLUMN_CREATE('a', 1));
--enable_result_log
--enable_query_log

--echo # Other native functions still resolve normally.
SELECT ABS(-2);
